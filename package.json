{
  "name": "lol-whatsapp-notifier",
  "version": "1.0.0",
  "description": "Send a WhatsApp message when a League of Legends account finishes a new match",
  "type": "module",
  "scripts": {
    "dev": "node --loader ts-node/esm src/index.ts",
    "test:message": "node --loader ts-node/esm src/test-message.ts",
    "test:whatsapp": "node --loader ts-node/esm src/test-whatsapp.ts",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.23",
    "axios": "^1.17.0",
    "dotenv": "^17.4.2",
    "node-cron": "^4.2.1",
    "pino": "^10.3.1",
    "qrcode-terminal": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode-terminal": "^0.12.2",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
